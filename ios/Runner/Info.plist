<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Agentmux Mobile</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>agentmux_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Export compliance declaration, required before App Store Connect will
	     let a build be submitted for review — without it, submission blocks
	     on an interactive question in App Store Connect that CI can't answer.
	     Set to `false` on the assumption this app only uses standard TLS
	     (HTTPS/WSS) via the OS-provided network stack, with no custom/
	     proprietary encryption of its own — the common "exempt" case. This is
	     a legal compliance declaration: confirm it's accurate for this app
	     before the first real App Store submission, don't take it as decided. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- LAN discovery: required for mDNS multicast on iOS 14+ -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>AgentMux needs local network access to discover AgentMux instances on your WiFi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_agentmux._tcp</string>
	</array>
	<!-- QR code fallback pairing: mobile_scanner needs camera access -->
	<key>NSCameraUsageDescription</key>
	<string>AgentMux needs camera access to scan a QR code for pairing with your desktop.</string>
	<!-- Cognito PKCE OAuth callback (flutter_web_auth_2) — must match
	     _redirectUri/_callbackScheme in lib/core/auth/auth_repository.dart
	     and the app client's allowed callback URL. See README.md's
	     "Platform setup" section. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>agentmuxmobile</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
